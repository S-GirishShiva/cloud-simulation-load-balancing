<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for standard output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger configuration -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- CloudSim Plus logger - WARN level reduces logging overhead -->
    <!-- CloudSim Plus generates 10-100 log entries per tick at INFO level -->
    <!-- Setting to WARN improves performance by 5-10x in large simulations -->
    <logger name="org.cloudsimplus" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Application logger - INFO for operational visibility -->
    <logger name="com.cloudsimulation" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Production Profile Logback Configuration
  Purpose: Error-level logging for production runs
  Target: ERROR level - only critical errors
  Used by: mvn exec:java -Pprod
-->
<configuration>
    <!-- Console appender for standard output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for production error logs -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/production.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger at ERROR level -->
    <root level="ERROR">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- CloudSim Plus logger - ERROR level only -->
    <logger name="org.cloudsimplus" level="ERROR" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- Application logger - ERROR level for production -->
    <logger name="com.cloudsimulation" level="ERROR" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>
</configuration>
